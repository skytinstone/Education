# 운영 서버용 설정 — 서버에서:  cp .env.production.example .env  (그다음 값 채우기)
# 비밀번호·키는 아래 명령으로 새로 만든다 (개발용 .env 값을 재사용하지 말 것):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

DOMAIN=eurekai.cloud

# DB 비밀번호 — 접속 주소(DATABASE_URL)는 docker-compose.prod.yml 이 이 값으로 만든다
POSTGRES_PASSWORD=
# 로그인 토큰 서명 키 (48자 이상 권장)
JWT_SECRET=

# ---------- 간편 로그인 (비워 두면 해당 버튼은 '준비 중') ----------
# 콘솔에 등록할 Redirect URI:
#   https://eurekai.cloud/api/auth/google/callback
#   https://eurekai.cloud/api/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 대화 첨부 'Google Drive 에서 고르기' (선택) — 같은 Cloud 프로젝트에서 Google Picker API·Google Drive API 사용 설정,
# API 키 만들기(애플리케이션 제한: HTTP 리퍼러=사이트 주소, API 제한: Picker API), OAuth 클라이언트에 '승인된 JavaScript 원본'으로
# 사이트 주소 추가, OAuth 동의 화면에 drive.file 범위 추가. GOOGLE_APP_ID 는 프로젝트 번호(숫자)
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 백업을 올릴 S3 버킷 이름 (비워 두면 서버 backups/ 에만 남는다) — scripts/backup.sh
BACKUP_S3_BUCKET=

# 운영자 계정 (쉼표로 여러 개) — 이 이메일로 https://도메인/admin 에 로그인하면 관리자 페이지가 열린다
ADMIN_EMAILS=

# 메일 (선택) — 새 피드백 알림과 '비밀번호 찾기' 재설정 링크에 쓴다. 비워 두면 비밀번호 찾기가 메일을 보내지 못한다
# Gmail: 2단계 인증 켜기 → https://myaccount.google.com/apppasswords 에서 앱 비밀번호 발급
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FEEDBACK_NOTIFY_EMAIL=horcruxtech.ai@gmail.com

# 학교 검색 키 (선택) — https://open.neis.go.kr 회원가입 → 인증키 신청. 없으면 검색 결과가 5개까지만 나온다
NEIS_API_KEY=

# 책 검색 (선택) — 카카오 책 검색은 위 KAKAO_REST_API_KEY 를 그대로 쓴다. Google Books 도 쓰려면 키를 넣는다
GOOGLE_BOOKS_API_KEY=

# ---------- AI (OpenAI) — 비워 두면 대화 답변은 문제 은행에서 고른다 ----------
OPENAI_API_KEY=

# ---------- 사용 한도 · 오류 추적 ----------
# 한 사람이 하루에 쓸 수 있는 AI (비용 달러 / 호출 수 중 먼저 닿는 쪽, 0 이면 제한 없음, 운영자는 제외)
AI_DAILY_LIMIT_USD=2.0
AI_DAILY_LIMIT_CALLS=400
# 오류 추적 (선택) — https://sentry.io 에서 Python 프로젝트를 만들고 DSN 을 넣으면 서버 오류가 모인다
SENTRY_DSN=
