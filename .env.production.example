# 운영 서버용 설정 — 서버에서:  cp .env.production.example .env  (그다음 값 채우기)
# 비밀번호·키는 아래 명령으로 새로 만든다 (개발용 .env 값을 재사용하지 말 것):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

DOMAIN=eurekai.cloud

# DB 비밀번호 — 접속 주소(DATABASE_URL)는 docker-compose.prod.yml 이 이 값으로 만든다
POSTGRES_PASSWORD=
# 로그인 토큰 서명 키 (48자 이상 권장)
JWT_SECRET=

# ---------- 간편 로그인 (비워 두면 해당 버튼은 '준비 중') ----------
# 콘솔에 등록할 Redirect URI:
#   https://eurekai.cloud/api/auth/google/callback
#   https://eurekai.cloud/api/auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 백업을 올릴 S3 버킷 이름 (비워 두면 서버 backups/ 에만 남는다) — scripts/backup.sh
BACKUP_S3_BUCKET=

# 운영자 계정 (쉼표로 여러 개) — 이 이메일로 로그인하면 프로필 메뉴에 '피드백 관리'가 보인다
ADMIN_EMAILS=

# 새 피드백 메일 알림 (선택) — Gmail: 2단계 인증 켜기 → https://myaccount.google.com/apppasswords 에서 앱 비밀번호 발급
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FEEDBACK_NOTIFY_EMAIL=horcruxtech.ai@gmail.com

# 학교 검색 키 (선택) — https://open.neis.go.kr 회원가입 → 인증키 신청. 없으면 검색 결과가 5개까지만 나온다
NEIS_API_KEY=

# ---------- AI (OpenAI) — 비워 두면 대화 답변은 문제 은행에서 고른다 ----------
OPENAI_API_KEY=
