# 복사해서 .env 로 쓰세요:  cp .env.example .env  (그다음 값 채우기)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://eureka:change-me@127.0.0.1:5433/eureka
TEST_DATABASE_URL=postgresql+psycopg://eureka:change-me@127.0.0.1:5433/eureka_test

# 로그인 토큰 서명 키 — 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# ---------- 간편 로그인 (비워 두면 해당 버튼은 '준비 중') ----------
# 콘솔에 등록할 Redirect URI: {PUBLIC_BASE_URL}/api/auth/google/callback, /api/auth/kakao/callback
PUBLIC_BASE_URL=http://localhost:8000
# Google Cloud Console → OAuth 클라이언트 ID (웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao Developers → 앱 키의 REST API 키, 보안 → Client Secret (선택이지만 권장)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
